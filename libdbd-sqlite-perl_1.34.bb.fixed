DESCRIPTION = "DBD::SQLite - SQLite driver for the Perl5 Database Interface (DBI)"
SECTION = "libs"
LICENSE = "Artistic|GPL"
PR = "r20"

FULL_OPTIMIZATION = "-fexpensive-optimizations -fomit-frame-pointer -frename-registers -O2 -ggdb -feliminate-unused-debug-types"

ARM_INSTRUCTION_SET = "arm"

DEPENDS = "libdbi-perl libdbi-perl-native sqlite3"

SRC_URI = "http://cpan.metacpan.org/authors/id/A/AD/ADAMK/DBD-SQLite-1.34_01.tar.gz;md5sum=2583ad592bfc9ea443860c12c303b6b8;sha256sum=21e5ceced5fce0143b0035ac8d2cfb152e5b1ed1d426438ec47dac30ea5f36dc"

S = "${WORKDIR}/DBD-SQLite-1.34_01"

inherit cpan

FILES_${PN}-doc = "${PERLLIBDIRS}/*.pod"
FILES_${PN} = "${PERLLIBDIRS}"

cpan_do_install() {
        # from cpan class
        if [ yes = "yes" ]; then
                oe_runmake install_vendor
        fi

        # Remove unnecessary large source files
        rm -rf ${D}/${prefix}/lib/perl5/auto/share/dist/DBD-SQLite
}

do_configure() {
    export PERL5LIB="${STAGING_LIBDIR_NATIVE}/perl/5.10.0:$PERL5LIB"
    export PATH="${STAGING_BINDIR_NATIVE}:$PATH"
    
    # Bypass DBI version check in Makefile.PL which fails due to native perl dlopen issues
    sed -i "s/require DBI;/my \$DBI_required = 0; eval 'package DBI; sub VERSION { 1.616 } package DBI::DBD; sub dbd_postamble { \"\" }';/" Makefile.PL
    sed -i "s/DBI->VERSION/1.616/g" Makefile.PL
    sed -i "s/require DBI::DBD;/#require DBI::DBD;/" Makefile.PL
    
    # Use absolute path to staged perl
    yes '' | ${STAGING_BINDIR_NATIVE}/perl Makefile.PL ${EXTRA_CPANFLAGS}
    if [ "${BUILD_SYS}" != "${HOST_SYS}" ]; then
        . ${STAGING_DIR}/${TARGET_SYS}/perl/config.sh
        sed -i -e "s:\(LDDLFLAGS.*\)${STAGING_LIBDIR_NATIVE}:\1${STAGING_LIBDIR}:" Makefile
        # Fix hardcoded paths that cause do_compile to fail
        sed -i -e "s:/usr/lib/perl/5.10:${STAGING_LIBDIR}/perl/5.10.0:g" Makefile
        sed -i -e "s:/usr/lib/perl5:${STAGING_LIBDIR}/perl5:g" Makefile
    fi
}
